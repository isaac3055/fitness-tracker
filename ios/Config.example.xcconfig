// Copy to Config.xcconfig (ignored by git). Slash expansion preserves URLs in xcconfig.
SLASH = /
SUPABASE_URL = https:$(SLASH)$(SLASH)YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_PUBLISHABLE_OR_ANON_KEY
WEB_APP_URL = https:$(SLASH)$(SLASH)YOUR_APP.vercel.app
